# Rupee MiTR Localhost — copy to .env and fill in real values
# cp .env.example .env

# Tenant IDs
TENANT_IDS=1

# Database Configuration (localhost)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=vimanoDB
DB_PORT=3306

# Master Database Configuration (localhost)
DB_MASTER_HOST=127.0.0.1
DB_MASTER_USER=root
DB_MASTER_PASSWORD=your_db_password
DB_MASTER_NAME=adminone_baseline_uat

# Tenant 1 - Rupee MiTR (localhost)
RUPEEMITR_DB_HOST=127.0.0.1
RUPEEMITR_DB_USER=root
RUPEEMITR_DB_PASSWORD=your_db_password
RUPEEMITR_DB_NAME=rupeemit_r112_prod

# JWT Configuration
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=24h

# Server Configuration
PORT=7000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
baseurl=http://localhost:7000
IMAGEBASEURL=http://localhost:7000

CREATE_USER_SECRET_KEY=adminone

# Email API Configuration
LENDIX_URL=https://api-dev.lendix.ai/email/send
LENDIX_API_KEY=your_lendix_api_key

# Tenant 1 - Rupee MiTR Email
RUPEEMITR_FROM_EMAIL="info@rupeemitr.com"
RUPEEMITR_EMAIL_API_KEY=your_email_api_key

# SMS API Configuration
NOVA_SMS_API_URL=https://api-dev.lendix.ai/sms/send

# Tenant 1 - Rupee MiTR SMS
RUPEEMITR_NOVA_SMS_API_KEY=your_sms_api_key
SMS_RUPEEMITR_SHORT_LINK=www.rupeemitr.com
SMS_RUPEEMITR_HEADER_KEY=sub_rupeemitr_campx
SMS_RUPEEMITR_TEMPLATE_ID=your_dlt_template_id
SMS_RUPEEMITR_DLT_ENTITY_ID=your_dlt_entity_id

# MongoDB Configuration for Logs (localhost)
MONGODB_URI=mongodb://localhost:27017/vimano_logs
MONGODB_LOG_COLLECTION=user_activity_logs

# Rupee MiTR Tenant - DocumentDB Logs (localhost)
RUPEEMITR_DOCUMENTDB_URI=mongodb://localhost:27017/vimanotech_rupeemitr_logs
RUPEEMITR_DOCUMENTDB_NAME=vimanotech_rupeemitr_logs
RUPEEMITR_DOCUMENTDB_CA_PATH=

# Optional - Super Admin IDs per tenant
tenant_SUPERADMINID_1=1
