{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",

    "strict": false,                   // disables all strict mode checks
    "noImplicitAny": false,            // allows implicit any types
    "strictNullChecks": false,         // allows null/undefined more freely
    "strictFunctionTypes": false,      // relaxes function assignment rules
    "noImplicitReturns": false,        // don't require all code paths to return
    "noUnusedParameters": false,       
    "noUnusedLocals": false,
    "noFallthroughCasesInSwitch": false,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

