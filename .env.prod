# --- Cron schedules ---
# CSV_DOWNLOAD_CRON_SCHEDULE has NO code fallback — must be set or node-cron crashes on boot.
CSV_DOWNLOAD_CRON_SCHEDULE=*/2 * * * *

# MongoDB / DocumentDB (logging only). Empty = app skips logging cleanly.
# <<DECIDE: prod logging DB — leave empty, or set DocumentDB/Mongo URI (TLS must be in the URI string)>>
MONGODB_URI=

# --- Redis ---
# <<DECIDE: prod Redis. If running redis locally on the EC2, localhost:6379 is fine.
#   If using ElastiCache, set REDIS_HOST/PORT/PASSWORD/TLS accordingly.>>
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS=false
REDIS_DB=0

